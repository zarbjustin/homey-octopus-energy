{
  "name": { "en": "Price Timeline" },
  "settings": [
    {
      "id": "device",
      "type": "device",
      "title": { "en": "Electricity meter" },
      "filter": "driver_id=electricity"
    },
    {
      "id": "green_max",
      "type": "number",
      "title": { "en": "Green up to (p/kWh)" },
      "value": 10,
      "min": 0,
      "max": 200,
      "hint": { "en": "Prices from zero through this value are green. Negative prices are always blue." }
    },
    {
      "id": "yellow_max",
      "type": "number",
      "title": { "en": "Yellow up to (p/kWh)" },
      "value": 20,
      "min": 0,
      "max": 200
    },
    {
      "id": "orange_max",
      "type": "number",
      "title": { "en": "Orange up to (p/kWh)" },
      "value": 30,
      "min": 0,
      "max": 200,
      "hint": { "en": "Prices above this value are red. Thresholds must increase from green to yellow to orange." }
    },
    {
      "id": "palette",
      "type": "dropdown",
      "title": { "en": "Colour palette" },
      "value": "standard",
      "values": [
        { "id": "standard", "title": { "en": "Standard" } },
        { "id": "colourblind", "title": { "en": "Colour-blind friendly" } },
        { "id": "high_contrast", "title": { "en": "High contrast" } }
      ]
    }
  ],
  "height": 150,
  "api": {
    "getData": { "method": "GET", "path": "/" }
  }
}
